menu "Meshenger configuration"

    config MESHENGER_OVERRIDE_DEVICE_CONFIG
        bool "Override stored device configuration"
        default n
        help
            Use build-time device configuration instead of the configuration
            stored in NVS.

    config MESHENGER_GROUP_ID
        int "Group ID"
        depends on MESHENGER_OVERRIDE_DEVICE_CONFIG
        range 0 3
        default 0

        help
            Group ID used when device configuration override is enabled.

endmenu